# 使用 Python 3.13 官方镜像作为基础[reference:5][reference:6]
FROM python:3.13-slim

# 设置容器内的工作目录
WORKDIR /app

# 将依赖文件复制到容器内，并安装
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 将项目所有文件复制到容器内的工作目录
COPY . .

# 声明容器运行时监听的端口（通常为8000）
EXPOSE 8000

# 容器启动时运行的命令
# 使用 uvicorn 启动，--host 0.0.0.0 让容器可以接收外部请求[reference:7]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]