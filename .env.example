# ============================================
# MDPI Asset Manager - 环境变量模板
# 使用方法：cp .env.example .env 然后按需修改
# ⚠️ 不要将真实的 .env 文件提交到 Git！
# ============================================

# ---------- MySQL ----------
# root 用户密码（首次启动时设置，后续修改需进容器手动改）
MYSQL_ROOT_PASSWORD=change_me_strong_password

# 业务数据库名
MYSQL_DATABASE=asset_manager

# 业务数据库用户（可选：使用 root 时可不设）
MYSQL_USER=asset_user
MYSQL_PASSWORD=change_me_db_password

# ---------- FastAPI ----------
# 数据库连接串（host 必须是 compose 中的服务名 mysql8.0）
DATABASE_URL=mysql+pymysql://root:change_me_strong_password@mysql8.0:3306/asset_manager

# 应用运行端口（与 docker-compose.yml 保持一致）
APP_PORT=9000

# ---------- 时区 ----------
TZ=Asia/Shanghai