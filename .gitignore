# ============================================
# 环境变量与密钥
# ============================================
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.hypothesis/

# ============================================
# 数据库数据与备份
# ============================================
# 宿主机 MySQL 数据目录（如果放在项目内）
mysql_data/
mysql8.0/
data/

# SQL 备份与导出
*.sql
*.sql.gz
*.dump
backup_*
db_bak_*

# 初始化 SQL（如含敏感数据，取消下面注释）
# mysql_init/*.sql

# ============================================
# 项目备份目录（update 时生成的 bak）
# ============================================
*_bak_*/
*_backup_*/

# ============================================
# 日志与临时文件
# ============================================
*.log
# 忽略根目录的 logs（运行时日志），但不忽略 app/logs（代码）
/logs/*
!/logs/.gitkeep

# 如果你的运行日志在 app 下（看图好像没有，以防万一写上）
/app/logs/*.log
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# ============================================
# Docker
# ============================================
# 本地构建产物（如有）
.docker/

# ============================================
# IDE / 编辑器
# ============================================
.idea/
.vscode/
*.iml
*.sublime-project
*.sublime-workspace

# ============================================
# 操作系统
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================
# Node（如果前端有构建流程）
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================
# 其它
# ============================================
*.bak
*.orig
.cache/